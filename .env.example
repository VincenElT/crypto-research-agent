# Public market-data settings. Do not add exchange API keys in this version.
EXCHANGE_ID=binance
SYMBOL=BTC/USDT
TIMEFRAME=1d
CANDLE_LIMIT=400

# Required only for Scout/Skeptic. Leave empty to print the market summary only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database audit logging
SQLITE_DB_PATH=crypto_research.db

# Deterministic Risk Limits (Spot Long-Only)
MAX_POSITION_SIZE_USD=1000.0
MAX_PORTFOLIO_ALLOCATION_PCT=0.10
COOLDOWN_BARS=5
MAX_DRAWDOWN_PCT=0.15
MAX_VOLATILITY_PCT=0.08
MIN_SCOUT_CONFIDENCE=0.50
REQUIRE_SKEPTIC_APPROVAL=true
